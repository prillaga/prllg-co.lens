{
  "headers": [
    {
      "source": "/api/bookings/public",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=5, stale-while-revalidate=10"
        }
      ]
    },
    {
      "source": "/api/catalog/public",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/health",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
